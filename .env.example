# SpamGuard AI - environment variables
# Copy this file to ".env" and edit the values you need.  .env is git-ignored.
# NEVER commit real keys: only placeholders belong in this file.

# --------------------------------------------------------------------------- #
# Core behaviour (safe defaults - the app works with none of these set)       #
# --------------------------------------------------------------------------- #
SPAMGUARD_SPAM_THRESHOLD=0.50        # risk >= this  -> SPAM
SPAMGUARD_REVIEW_THRESHOLD=0.30      # risk >= this  -> NEEDS REVIEW
SPAMGUARD_RANDOM_STATE=42
SPAMGUARD_TEST_SIZE=0.20
SPAMGUARD_LOG_LEVEL=INFO
# SPAMGUARD_MODEL_PATH=models/sms_spam_pipeline.joblib
# SPAMGUARD_DATASET_PATH=data/processed/sms_spam.csv

# --------------------------------------------------------------------------- #
# OPTIONAL - plain-English AI explanations via a public AI API                #
# Provider must be one of: none | openai | gemini                             #
# --------------------------------------------------------------------------- #
AI_PROVIDER=none

# OpenAI (leave the key empty unless you use it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AI_TIMEOUT_SECONDS=25
